# syntax=docker/dockerfile:1.7
# Build tako for RHEL 9–class glibc (x86_64 only).
#
# Rocky Linux 9 ≈ RHEL 9 glibc. Building here avoids "GLIBC_2.xx not found"
# when the binary is later run on air-gapped RHEL 9.
#
# Target triple (when built with --platform=linux/amd64):
#   x86_64-unknown-linux-gnu
#
# Simpler than rakko's Dockerfile: plain ratatui binary — no cmake/perl/clang
# for librdkafka or OpenSSL vendoring. Just a Rust toolchain + build essentials.
#
# Caching: `RUN --mount=type=cache` persists ~/.cargo/registry and target/ across
# builds *outside* Docker's layer system, so it's keyed by cargo's own per-crate
# fingerprints, not by a Docker-layer-content hash. Version-only bumps therefore
# do not force a full dependency recompile.
#
# Portability: cache mounts need BuildKit. Confirmed pattern works on docker
# (buildx), podman (buildah), and Apple Container via
# `./scripts/build-tui-rhel9.sh` with each `DOCKER=` value.
#
# IMPORTANT — build context is the repo root (Cargo.toml + src/ at context root):
#
#   # from repo root (recommended):
#   ./scripts/build-tui-rhel9.sh
#
#   # manual:
#   docker build --platform linux/amd64 -f Dockerfile.rhel9 -t tako:rhel9 .
#
# On Apple Silicon you MUST pass --platform linux/amd64 (x86_64). Without working
# amd64 emulation you get: exec /bin/sh: exec format error
# Prefer Apple Container (DOCKER=container) if Docker's qemu/Rosetta is broken.
#
# Artifact inside the image:
#   /out/tako-linux-amd64          (clear platform name)
#   /out/tako                      (short name)
#   /out/SHA256SUMS
#   /out/ldd.txt                   (dynamic-link audit)

# Platform comes from `docker/container build --platform=…` (do not hardcode
# FROM --platform=linux/amd64 — BuildKit warns and some runtimes mishandle it).
FROM rockylinux:9

# Rocky 9 images ship curl-minimal, which conflicts with package "curl".
# rustup works with curl-minimal (provides /usr/bin/curl).
#
# binutils + file — diagnostics / strip-friendly toolchain
RUN dnf install -y \
        gcc gcc-c++ make \
        binutils file diffutils \
    && dnf clean all \
    && command -v curl >/dev/null \
    && curl --version | head -1

# Rust stable (network required at image-build time only)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal \
    && . /root/.cargo/env \
    && rustc --version \
    && rustc -vV | grep host

ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_BUILD_TARGET=x86_64-unknown-linux-gnu
# Keep jobs modest under qemu on Apple Silicon.
ENV CARGO_BUILD_JOBS=2

RUN rustup target add x86_64-unknown-linux-gnu

WORKDIR /src

# Context is repo root (Cargo.toml + src/ at the root of the context)
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY assets ./assets

# Explicit target for clarity when platform is linux/amd64.
# --mount=type=cache on the registry + target dirs is what makes repeat builds
# fast: cargo's own fingerprinting (not Docker layer hashing) decides what
# actually needs recompiling.
RUN --mount=type=cache,target=/root/.cargo/registry,id=tako-rhel9-cargo-registry \
    --mount=type=cache,target=/src/target,id=tako-rhel9-cargo-target \
    cargo fetch --target x86_64-unknown-linux-gnu \
    && cargo build --release --offline --target x86_64-unknown-linux-gnu \
    # target/ is a cache mount — copy the binary out to a regular layer (/out)
    # before this RUN ends, or it disappears with the mount.
    && mkdir -p /out \
    && cp target/x86_64-unknown-linux-gnu/release/tako /out/tako \
    && cp /out/tako /out/tako-linux-amd64 \
    && chmod +x /out/tako /out/tako-linux-amd64 \
    && (cd /out && sha256sum tako tako-linux-amd64 > SHA256SUMS) \
    && ls -la /out \
    && (command -v file >/dev/null && file /out/tako-linux-amd64 || true) \
    && (command -v ldd >/dev/null && ldd /out/tako-linux-amd64 | tee /out/ldd.txt || true) \
    && echo "==> auditing dynamic deps (expect glibc + libgcc_s only)" \
    && if ldd /out/tako-linux-amd64 2>/dev/null | grep -Eiq 'libssl|libcrypto|librdkafka'; then \
         echo "error: binary has unexpected dynamic crypto/rdkafka deps:" >&2; \
         ldd /out/tako-linux-amd64 >&2; \
         exit 1; \
       fi \
    && echo "dynamic-link audit passed"

CMD ["cat", "/out/SHA256SUMS"]
